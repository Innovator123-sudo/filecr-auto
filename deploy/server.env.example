# Server env — production
PORT=3001

# Origins allowed to call the API directly (split hosting only).
# Single-service hosting serves the client itself → same-origin, can stay empty.
CLIENT_ORIGIN=https://your-client.vercel.app

# Optional TURN relay for stricter NATs (P2P video)
TURN_URL=turn:openrelay.metered.ca:80
TURN_USER=openrelayproject
TURN_PASS=openrelayproject

# SINGLE-SERVICE MODE: point at the built client folder to serve the web app
# from this same service (recommended — see deploy/README.md). Leave unset in dev.
# STATIC_DIR=client/dist

# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
